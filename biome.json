{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/out",
			"!**/build",
			"!**/dist",
			"!**/coverage",
			"!**/*.min.js",
			"!**/public",
			"!next-env.d.ts",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf",
		"attributePosition": "auto"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error",
				"useJsxKeyInIterable": "error"
			},
			"suspicious": {
				"noDebugger": "error",
				"noConsole": "warn",
				"noDoubleEquals": "error",
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn",
				"noDuplicateJsxProps": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 20
					}
				},
				"noForEach": "warn",
				"useFlatMap": "error"
			},
			"style": {
				"useConst": "error",
				"useTemplate": "error",
				"useSelfClosingElements": "error",
				"useConsistentArrayType": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useNodejsImportProtocol": "error",
				"useNumberNamespace": "error",
				"useForOf": "error",
				"noNonNullAssertion": "warn",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"requireAscii": true,
						"filenameCases": ["camelCase", "PascalCase", "kebab-case"]
					}
				}
			},
			"a11y": {
				"useAltText": "warn",
				"useButtonType": "warn",
				"useAnchorContent": "warn",
				"useValidAnchor": "warn",
				"useKeyWithClickEvents": "warn",
				"noAriaHiddenOnFocusable": "error",
				"useSemanticElements": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error"
			},
			"performance": {
				"noBarrelFile": "warn",
				"noReExportAll": "warn"
			},
			"nursery": {
				"noFloatingPromises": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always",
			"quoteProperties": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"lineWidth": 80
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"lineWidth": 100
		},
		"linter": {
			"enabled": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": [
				"app/**/page.tsx",
				"app/**/layout.tsx",
				"app/**/loading.tsx",
				"app/**/error.tsx",
				"app/**/not-found.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "warn"
					}
				}
			}
		}
	]
}
